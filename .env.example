APP_NAME=Pawora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/PetShopnew/public
ASSET_URL=http://localhost/PetShopnew/public
SOCIALITE_SSL_VERIFY=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
